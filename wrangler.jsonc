{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kairos-web",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_NUMBER": "63554361",
    "FIREBASE_WEB_APP_ID": "1:63554361:web:59b6e3a71ab30274411ee8",
    "AI_DAILY_ACCOUNT_LIMIT": "100",
    "AI_DAILY_SITE_LIMIT": "1000",
    "AI_BUDGET_SCOPE": "production",
    "AI_PROVIDER": "openrouter",
    "AI_MODEL": "openai/gpt-oss-120b",
    "BILLING_ENABLED": "true",
    "ACCESS_CODES_ENABLED": "false",
    "AI_TIER_ENFORCEMENT": "true",
    "AI_FREE_DAILY_LIMIT": "15",
    "AI_PLUS_DAILY_LIMIT": "50",
    "STRIPE_MODE": "test",
    "BILLING_ORIGIN": "https://kairos-web.kirosapp.workers.dev",
    "STRIPE_PLUS_PRICE_ID": "price_1U77RyPX3ScSvSEmRHfq8vUQ",
    "STRIPE_PLUS_YEARLY_PRICE_ID": "price_1UTdu1PX3ScSvSEmLQ08zosd",
    "AI_FREE_WEEKLY_LIMIT": "50",
    "AI_PLUS_WEEKLY_LIMIT": "350"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026101001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "BILLING_RATE_LIMITER",
      "namespace_id": "2026101011",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": false
    }
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "previews": {
    "vars": {
      "FIREBASE_PROJECT_NUMBER": "63554361",
      "FIREBASE_WEB_APP_ID": "1:63554361:web:59b6e3a71ab30274411ee8",
      "AI_DAILY_ACCOUNT_LIMIT": "100",
      "AI_DAILY_SITE_LIMIT": "1000",
      "AI_BUDGET_SCOPE": "preview",
      "AI_PROVIDER": "openrouter",
      "AI_MODEL": "openai/gpt-oss-120b",
      "BILLING_ENABLED": "false",
      "ACCESS_CODES_ENABLED": "false",
      "AI_TIER_ENFORCEMENT": "true",
      "AI_FREE_DAILY_LIMIT": "15",
      "AI_PLUS_DAILY_LIMIT": "50",
      "STRIPE_MODE": "test",
      "BILLING_ORIGIN": "https://kairos-web-preview.kirosapp.workers.dev",
      "AI_FREE_WEEKLY_LIMIT": "50",
      "AI_PLUS_WEEKLY_LIMIT": "350"
    },
    "ratelimits": [
      {
        "name": "AI_RATE_LIMITER",
        "namespace_id": "2026101003",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "BILLING_RATE_LIMITER",
        "namespace_id": "2026101013",
        "simple": {
          "limit": 10,
          "period": 60
        }
      }
    ]
  },
  "env": {
    "preview": {
      "name": "kairos-web-preview",
      "vars": {
        "FIREBASE_PROJECT_NUMBER": "63554361",
        "FIREBASE_WEB_APP_ID": "1:63554361:web:59b6e3a71ab30274411ee8",
        "AI_DAILY_ACCOUNT_LIMIT": "100",
        "AI_DAILY_SITE_LIMIT": "1000",
        "AI_BUDGET_SCOPE": "preview",
        "AI_PROVIDER": "openrouter",
        "AI_MODEL": "openai/gpt-oss-120b",
        "BILLING_ENABLED": "true",
        "ACCESS_CODES_ENABLED": "false",
        "AI_TIER_ENFORCEMENT": "true",
        "AI_FREE_DAILY_LIMIT": "15",
        "AI_PLUS_DAILY_LIMIT": "50",
        "STRIPE_MODE": "test",
        "BILLING_ORIGIN": "https://kairos-web-preview.kirosapp.workers.dev",
        "STRIPE_PLUS_PRICE_ID": "price_1U77RyPX3ScSvSEmRHfq8vUQ",
        "STRIPE_PLUS_YEARLY_PRICE_ID": "price_1UTdu1PX3ScSvSEmLQ08zosd",
        "AI_FREE_WEEKLY_LIMIT": "50",
        "AI_PLUS_WEEKLY_LIMIT": "350"
      },
      "ratelimits": [
        {
          "name": "AI_RATE_LIMITER",
          "namespace_id": "2026101002",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "BILLING_RATE_LIMITER",
          "namespace_id": "2026101012",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  }
}
