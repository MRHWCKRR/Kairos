{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kairos-web",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "FIREBASE_PROJECT_NUMBER": "63554361", "FIREBASE_WEB_APP_ID": "1:63554361:web:59b6e3a71ab30274411ee8" },
  "ratelimits": [{ "name": "AI_RATE_LIMITER", "namespace_id": "2026101001", "simple": { "limit": 10, "period": 60 } }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/api", "/api/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "triggers": { "crons": ["0 3 * * *"] },
  "env": {
    "preview": {
      "name": "kairos-web-preview",
      "vars": { "FIREBASE_PROJECT_NUMBER": "63554361", "FIREBASE_WEB_APP_ID": "1:63554361:web:59b6e3a71ab30274411ee8" },
      "ratelimits": [{ "name": "AI_RATE_LIMITER", "namespace_id": "2026101002", "simple": { "limit": 10, "period": 60 } }],
      "triggers": { "crons": [] }
    }
  }
}
