rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Discovery Marketplace: Anyone logged in can read all shared routines
    match /shared_routines/{routineId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // User profile: Only the owner can read or write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Study plans: Only the owner can read or write their own routines
    match /study_plans/{planId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userID;
      allow create: if request.auth != null;
    }

    // Private Kairos analytics: never accessible directly from browsers.
    // The Firebase Admin SDK used by the server bypasses these rules.
    match /kairosAnalytics/{eventId} {
      allow read, write: if false;
    }
  }
}
